[Unit]
Description=mos API daemon (serves the web dashboard)
After=network.target mosd.service
Wants=mosd.service
# StateDirectory below lives under /var/lib; apid persists its TLS material,
# its login-backoff counters and its audit ring there (access.md §6) and must
# not start against an unmounted STATE — counters written to a tmpfs standing
# in for an unmounted STATE would reset on the next power cycle, which is the
# exact bypass the persistence exists to close.
RequiresMountsFor=/var/lib/mos

[Service]
Type=simple
ExecStart=/usr/bin/apid
Restart=on-failure
StateDirectory=mos/apid
# 0700, not the systemd default 0755: the directory holds the TLS private
# key, the session-cookie signing key, the login-backoff counters and the
# audit trail. Every file inside is 0600; the directory matches. apid's own
# ensure_state_dir creates it 0700 when it creates it at all — this makes the
# systemd-created case agree.
StateDirectoryMode=0700

# Sandboxing for the network-facing daemon. apid stays root to bind 80/443
# and to read its StateDirectory, but it execs nothing, needs no home, no
# realtime, no writable-executable mappings, and speaks only unix (bus to
# mosd) and inet sockets.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The filesystem, read-only independently of dm-verity. apid writes exactly
# two trees: its StateDirectory (TLS material, the session signing key, the
# login-backoff counters, the audit ring) and the /srv/ui bundle store.
# StateDirectory=mos/apid above already exempts /var/lib/mos/apid from
# strict, so the list is /srv/ui alone. The leading '-' matters: apid never
# creates /srv/ui (the store requires an operator to), so on a device where
# no bundle was ever installed the path is absent and an unprefixed entry
# would fail the unit's namespace setup. Installing a bundle ends in an apid
# restart, which picks the directory up.
ProtectSystem=strict
ReadWritePaths=-/srv/ui

[Install]
WantedBy=multi-user.target
