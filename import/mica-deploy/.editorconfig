root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# rustfmt defaults: 4-space indent, 100 columns.
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,json,yml,yaml,md,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
