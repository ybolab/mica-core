# The micad producer: the `micad` and `mica-apid` packages, out of the micad Cargo
# workspace. Read by build-env/deb/producers.sh and build-env/deb/build.sh;
# the convention is documented in build-env/deb/README.md.
PACKAGES="micad mica-apid"
ARCHES="amd64 arm64"

# Each package owns the multi-user.target.wants symlink that starts it, as a
# file in its payload. Installing the package is what makes the daemon run;
# nothing calls `systemctl enable`.
ENABLEMENT="micad=1 mica-apid=1"

# The cargo cross-compile and the producer-independence assertion. Neither is a
# docker build, so neither can be a key above.
PREPARE="prepare.sh"

FROM_IMAGES="MICA_BUILD_DEB=LOCAL_MICA_BUILD_DEB"

# `family` is packaging/deb/, which holds the copyright file shared by every
# package of every producer in it; `dist` holds micad.service, apid.service and
# the D-Bus policy. Neither is inside this producer's directory, which is the
# build context.
BUILD_CONTEXTS="family=packaging/deb micad-dist=crates/micad/dist apid-dist=crates/apid/dist"
