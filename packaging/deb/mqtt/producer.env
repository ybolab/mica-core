# The MQTT producer: the `mica-mqttd` and `mica-mqtt-broker` packages, out of the
# micad Cargo workspace. Read by build-env/deb/producers.sh and
# build-env/deb/build.sh; the convention is documented in
# build-env/deb/README.md.
PACKAGES="mica-mqttd mica-mqtt-broker"
ARCHES="amd64 arm64"

# NEITHER PACKAGE SHIPS AN ENABLEMENT LINK, and the zeros are the declaration of
# that rather than a gap in this file. micad renders /run/mica/mqtt-broker.toml and
# /run/mica/mqttd-device.env from the settings tree and starts both units from
# `mqtt.enabled`, so a link in either payload would start a broker nobody asked
# for, before micad has rendered anything for it to read. Both units keep their
# [Install] section, so `systemctl enable` stays meaningful on a writable root;
# neither postinst calls it.
ENABLEMENT="mica-mqttd=0 mica-mqtt-broker=0"

PREPARE="prepare.sh"

FROM_IMAGES="MICA_BUILD_DEB=LOCAL_MICA_BUILD_DEB"

# TWO unit contexts rather than the micad producer's single `dist`: each of these
# units lives beside its own crate, and the only directory containing both is
# the workspace root, which carries the cargo target trees buildx must not walk.
# `family` is packaging/deb/, for the shared copyright file.
BUILD_CONTEXTS="family=packaging/deb mqttd-dist=crates/mica-mqttd/dist broker-dist=crates/mica-mqtt-broker/dist"
