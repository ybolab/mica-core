# The sftp producer: the `mica-sftp-server` package, out of the micad Cargo
# workspace. Read by scripts/deb/producers.sh and scripts/deb/build.sh;
# the convention is documented in scripts/deb/README.md.
PACKAGES="mica-sftp-server"
ARCHES="amd64 arm64"

# No unit, so no enablement link: dropbear execs the binary for each sftp
# session.
ENABLEMENT="mica-sftp-server=0"

PREPARE="prepare.sh"

FROM_IMAGES="MICA_BUILD_DEB=IMAGE_MICA_BUILD_BASE"

# `family` is packaging/deb/, for the shared copyright file.
BUILD_CONTEXTS="family=packaging/deb"
