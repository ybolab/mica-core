# The apid producer: the `mica-apid` package, out of the workspace. Read by
# build-env/deb/producers.sh and build-env/deb/build.sh; the convention is
# documented in build-env/deb/README.md.
#
# Its own producer and its own executable, not a link to micad: an apid
# upgrade rebuilds and repacks this package only, never the micad binary.
PACKAGES="mica-apid"
ARCHES="amd64 arm64"

# The package owns the multi-user.target.wants symlink that starts apid.
ENABLEMENT="mica-apid=1"

PREPARE="prepare.sh"

FROM_IMAGES="MICA_BUILD_DEB=LOCAL_MICA_BUILD_DEB"

# `family` is packaging/deb/, for the shared copyright file; `apid-dist`
# holds apid.service.
BUILD_CONTEXTS="family=packaging/deb apid-dist=crates/mica-apid/dist"
