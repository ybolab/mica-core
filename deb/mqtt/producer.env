# The MQTT producer: the `mos-mqttd` and `mos-mqtt-broker` packages, out of the
# mosd Cargo workspace. Read by build-env/deb/producers.sh and
# build-env/deb/build.sh; the convention is documented in
# build-env/deb/README.md.
PACKAGES="mos-mqttd mos-mqtt-broker"
ARCHES="amd64 arm64"

# NEITHER PACKAGE SHIPS AN ENABLEMENT LINK, and the zeros are the declaration of
# that rather than a gap in this file. mosd renders /run/mos/mqtt-broker.toml and
# /run/mos/mqttd-device.env from the settings tree and starts both units from
# `mqtt.enabled`, so a link in either payload would start a broker nobody asked
# for, before mosd has rendered anything for it to read. Both units keep their
# [Install] section, so `systemctl enable` stays meaningful on a writable root;
# neither postinst calls it.
ENABLEMENT="mos-mqttd=0 mos-mqtt-broker=0"

PREPARE="prepare.sh"

FROM_IMAGES="MOS_BUILD_DEB=LOCAL_MOS_BUILD_DEB"

# TWO unit contexts rather than the mosd producer's single `dist`: each of these
# units lives beside its own crate, and the only directory containing both is
# the workspace root, which carries the cargo target trees buildx must not walk.
# `family` is pkgs/mosd/deb/, for the shared copyright file.
BUILD_CONTEXTS="family=pkgs/mosd/deb mqttd-dist=pkgs/mosd/mqttd/dist broker-dist=pkgs/mosd/broker/dist"
