# The lifecycle producer: the `mica-lifecycle` package -- the two static
# native executables the signed kernel image carries in its initramfs and
# exit ramdisk, mica-init and mica-shutdown. Read by build-env/deb/producers.sh
# and build-env/deb/build.sh; the convention is documented in
# build-env/deb/README.md.
#
# NOT A ROOT PACKAGE. No manifest of the assembly names it and the composer
# never installs it: the assembly's kernel component reads the two
# executables out of this archive (tools/lifecycle-pool.sh there) and packs
# them into the UKI or FIT, where they are part of the authenticated kernel
# identity. The archive is the transport that lets the kernel be built from
# the same commit's binaries the pin names.
PACKAGES="mica-lifecycle"

# One archive per architecture: two ELF executables each, static, for the
# board's own CPU.
ARCHES="amd64 arm64"

# Nothing to enable: the payload is not installed into a root at all.
ENABLEMENT="mica-lifecycle=0"

# hack/build-deb.sh compiles both with +crt-static and refuses a result that
# has an interpreter or a NEEDED entry; see the script.
PREPARE="prepare.sh"

FROM_IMAGES="MICA_BUILD_DEB=LOCAL_MICA_BUILD_DEB"

BUILD_CONTEXTS="family=deb"
