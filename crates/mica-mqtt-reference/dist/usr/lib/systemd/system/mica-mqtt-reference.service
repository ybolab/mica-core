[Unit]
Description=mica MQTT reference application
After=dbus.service
Before=mica-mqttd.service

[Service]
Type=dbus
BusName=com.mica.mqttsample.reference
ExecStart=/usr/bin/mica-mqtt-reference
Restart=on-failure
RestartSec=5s
User=mica
Group=mica
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
RemoveIPC=yes
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
