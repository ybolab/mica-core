# Where artifacts are published and fetched: an OCI registry, one PUBLIC
# package per publishing repository under <host>/<owner>, with what the
# artifact is in the tag: <repository>:source.build-<commit12>,
# <repository>:pool.<arch>.build-<commit12>, mica-boards:board.<board>.build-<commit12>,
# mica-build:root.<product>.build-<commit12>; pinned by digest. Artifacts of
# before are still read from the shared mica-pool and mica-source packages.
# Plain KEY=value, sourced by scripts/deb/{lock,publish}.sh.
MICA_REGISTRY=ghcr.io/ybolab
# The name the token logs in as (GHCR takes any name with a token).
MICA_REGISTRY_USER=ybolab
# The variable holding the token, never the token; `gh auth token` is the fallback.
MICA_RELEASE_TOKEN_VAR=GH_TOKEN
# Where source.sh clones a package repository from, <prefix>/<component>.git.
# https, so that a runner with no SSH key reads the same repositories the
# token already reads: source.sh sends that token on the clone as an
# Authorization header and never writes it into the checkout.
MICA_SOURCE_URL=https://github.com/ybolab
